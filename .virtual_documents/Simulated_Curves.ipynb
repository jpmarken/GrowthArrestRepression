beta_factor = np.logspace(0,2,100)
fc_ls = []
for bf in beta_factor:
    b_s_new = b_s * bf
    b_p_new = b_p * bf
    a_s_new = a_s * bf
    a_p_new = a_p * bf
    params_s = (b_s_new, a_s_new, K_s, n_s)
    params_p = (b_p_new, a_p_new, K_p, n_p)
    fc_ls.append(SP_composition_FC(params_s, params_p))

plt.figure(figsize=(6,4))
